{
  "name": "raidline",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node scripts/vinext-start.mjs",
    "test": "pnpm run test:unit && pnpm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "tsx --test tests/core.test.ts tests/wcl.test.ts tests/wcl-event-review.test.ts tests/wcl-conversion.test.ts tests/wcl-import.test.ts tests/player-skill-import.test.ts",
    "lint": "eslint app lib scripts tests \"*.ts\" \"*.mjs\" --ignore-pattern dist --ignore-pattern .next",
    "wcl:download": "tsx scripts/wcl-download.ts",
    "wcl:review": "tsx scripts/wcl-review.ts",
    "wcl:convert": "tsx scripts/wcl-convert.ts"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.5",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13"
  },
  "type": "module"
}
