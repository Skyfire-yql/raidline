# Copy this file to .env.local for local development. Never commit real values.
# Only the administrator values below belong in the current private Sites runtime.
ADMIN_PASSWORD_HASH=sha256-of-generated-admin-password
ADMIN_SESSION_SECRET=long-random-session-secret

# Warcraft Logs 公共 API；仅供本机/自有服务端读取，当前不要配置到 Sites。
# 不得使用 VITE_ / NEXT_PUBLIC_ 前缀。
WCL_CLIENT_ID=warcraft-logs-client-id
WCL_CLIENT_SECRET=warcraft-logs-client-secret
WCL_TOKEN_URL=https://www.warcraftlogs.com/oauth/token
WCL_API_URL=https://www.warcraftlogs.com/api/v2/client
